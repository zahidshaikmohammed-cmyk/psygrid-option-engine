# Copy to .env and adjust. All variables are optional; defaults shown.
# See docs/CONFIG.md for descriptions. No secrets are required for the
# currently-documented public PSYGRID endpoints.

PSYGRID_BASE_URL=http://140.245.226.102:10000

PSYGRID_HTTP_TIMEOUT_SECONDS=5.0
PSYGRID_HTTP_CONNECT_TIMEOUT_SECONDS=3.0
PSYGRID_MAX_RETRIES=3
PSYGRID_RETRY_BACKOFF_SECONDS=0.5

PSYGRID_FRESHNESS_TOLERANCE_UNDERLYING_SECONDS=15.0
PSYGRID_FRESHNESS_TOLERANCE_OPTIONS_SECONDS=15.0
PSYGRID_FRESHNESS_TOLERANCE_DEPTH_SECONDS=10.0
PSYGRID_FRESHNESS_TOLERANCE_INDICATORS_SECONDS=60.0
PSYGRID_FRESHNESS_TOLERANCE_FUTURES_SECONDS=15.0
PSYGRID_FRESHNESS_TOLERANCE_BREADTH_SECONDS=60.0
PSYGRID_FRESHNESS_TOLERANCE_CONTEXT_SECONDS=21600.0
PSYGRID_FRESHNESS_TOLERANCE_NEWS_SECONDS=86400.0
PSYGRID_FRESHNESS_TOLERANCE_VIX_SECONDS=30.0

PSYGRID_DECISION_INTERVAL_SECONDS=15.0

PSYGRID_MARKET_OPEN=09:15
PSYGRID_MARKET_CLOSE=15:30
PSYGRID_OPENING_PERIOD_MINUTES=15
PSYGRID_ENTRY_CUTOFF=15:00
PSYGRID_LATE_SESSION_START=14:30
